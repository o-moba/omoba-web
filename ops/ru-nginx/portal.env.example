# Website source may come from dev; the public domain uses the production contour.
OMOBA_MARKET=ru
OMOBA_CONTOUR=production
OMOBA_PORTAL_ORIGIN=https://omoba.ru
OMOBA_ACCOUNT_MODE=disabled
# Owner will create the real VK ID application later. Never put a test id here.
OMOBA_VKID_CLIENT_ID=
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3010
NEXT_TELEMETRY_DISABLED=1
NODE_OPTIONS=--max-old-space-size=320
