export type TierId = "rose" | "jade" | "azure" | "crimson" | "prism_i" | "prism_ii" | "prism_iii";
export type StyleId = "solar" | "lunar" | "verdant" | TierId;
export type Tier = Readonly<{ id: TierId; points: number; color: string | null; prism: number | null }>;
export type Grant = { provider: string; valid_from: number; valid_until: number; revoked: boolean; tier_points?: number };
export type TierStatus = { active: boolean; active_until: number | null; grants: Grant[]; tier_points?: number; tier_until?: number | null };
export type Quote = { amount_minor: number; currency: string; duration_days: number; tier: string | null };
export const KOPECKS: 100;
export const MIN_RUB: 100;
export const MAX_RUB: 100000;
export const GRANT_DAYS: 30;
export const TIERS: readonly Tier[];
export const TIER_AMOUNTS_RUB: readonly number[];
export const BASE_STYLES: readonly Readonly<{ id: "solar" | "lunar" | "verdant"; color: string }>[];
export const AURA_STYLES: readonly StyleId[];
export const AURA_NAMES: Readonly<Record<"en" | "ru" | "zh", Readonly<Record<StyleId, string>>>>;
export function auraName(id: string, locale: "en" | "ru" | "zh"): string;
export function tierFor(points: number): Tier | null;
export function tierOfStyle(id: string): Tier | null;
export function amountAllowed(rub: unknown): rub is number;
export function parseRubles(input: unknown): number | null;
export function quoteFor(rub: number, offer: { currency: string; duration_days: number }): Quote;
export function receiptEmail(raw: unknown): string | null;
export function pointsAt(grants: readonly Grant[], at: number): number;
export function tierSteps(status: TierStatus, now: number): { tier: TierId; until: number }[];
export function styleUnlocked(style: string, status: TierStatus): boolean;
export function formatRubles(minor: number, locale: string): string;
