# Local development only; production origin must be HTTPS.
OMOBA_PORTAL_ORIGIN=http://127.0.0.1:3010
OMOBA_ACCOUNT_API_URL=http://127.0.0.1:40550
# Public guest-only deployments: disabled. Omit or use enabled for a real API.
OMOBA_ACCOUNT_MODE=enabled
# Only for a production-mode build tested on loopback HTTP, never remote HTTP.
OMOBA_ALLOW_INSECURE_LOCAL=1

# Contour: production (default when unset) or dev, nothing else. dev accepts only
# https://registry.dev.ekza.io, https://studio.dev.ekza.io and https://app.dev.omoba.io
# (loopback doubles with OMOBA_ALLOW_INSECURE_LOCAL=1). See docs/vercel.md#contours.
# OMOBA_CONTOUR=dev

# Build market (docs/markets.md): global (default when unset), ru or cn; the same switch as
# the game. ru/cn: no Ekza, no payments; ru signs in with VK ID. Rebuild after a change.
# OMOBA_MARKET=ru
# Per-feature overrides: on|off, empty keeps the market's preset.
# OMOBA_FEATURE_EKZA=
# OMOBA_FEATURE_SUPPORTER=
# OMOBA_FEATURE_VK_SIGN_IN=
# VK ID app id (one public app for VK, OK, Mail.ru; no secret). Trusted redirect URL:
# ${OMOBA_PORTAL_ORIGIN}/api/auth/vk/callback
# OMOBA_VKID_CLIENT_ID=12345

# Market: Ekza Registry and Studio. Unset means the contour's own origin (production
# below); another origin is accepted only on loopback with OMOBA_ALLOW_INSECURE_LOCAL=1.
# OMOBA_REGISTRY_URL=https://registry.ekza.io
# OMOBA_STUDIO_URL=https://studio.ekza.io
# Local Registry rig:
# OMOBA_REGISTRY_URL=http://127.0.0.1:8018
# OMOBA_STUDIO_URL=http://127.0.0.1:5188

# Public landing origin used by back-to-site links. HTTPS in production. Unset means
# https://omoba.io (production) or https://dev.omoba.io (dev; nothing else allowed there).
# For a local round trip in development: http://127.0.0.1:3102
OMOBA_SITE_URL=https://omoba.io

# Enable only behind a private ingress that OVERWRITES X-Real-IP; same flag on API.
# OMOBA_TRUST_LOOPBACK_PROXY=1
