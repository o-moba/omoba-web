{
  "name": "omoba-player-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "npm run catalog:check && npm run workshop:check && next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.e2e.mjs",
    "test:app-loop": "node tests/app-loop.e2e.mjs",
    "test:load": "node tests/load.mjs",
    "catalog:import": "node scripts/import-asset-catalog.mjs",
    "test:creators": "node tests/creators.e2e.mjs",
    "catalog:check": "node scripts/import-asset-catalog.mjs --check",
    "workshop:import": "node scripts/import-workshop.mjs",
    "workshop:check": "node scripts/import-workshop.mjs --check",
    "test:workshop": "node tests/workshop.e2e.mjs",
    "test:guest-deployment": "node tests/guest-deployment.e2e.mjs",
    "test:first-paint": "node tests/first-paint.e2e.mjs",
    "test:market": "node tests/market.e2e.mjs",
    "test:https-cookies": "node tests/https-cookies.e2e.mjs",
    "test:contour": "node tests/contour.e2e.mjs",
    "test:vercel-cli": "node tests/vercel-cli.e2e.mjs",
    "test:market-preview": "node tests/market-preview.e2e.mjs"
  },
  "dependencies": {
    "@ekza/avatar-renderer": "git+https://github.com/ekza-space/ekza-avatar-renderer.git#f650dd9dae170fcdc3da165fb3a9d92324b73522",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
